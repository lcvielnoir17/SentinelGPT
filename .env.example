# =============================================================================
# SentinelGPT - Environment Configuration Template
# Copy this file to .env and adjust variables as appropriate.
# DO NOT commit real secrets or credentials to version control.
# =============================================================================

# Application Configuration
APP_NAME="SentinelGPT API"
APP_VERSION="0.1.0"
ENVIRONMENT="local"
DEBUG=false
API_V1_PREFIX="/api/v1"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# Structured Logging
LOG_LEVEL="INFO"
LOG_JSON=false

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/sentinelgpt"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Redis Cache & Broker Configuration
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Gemini AI Configuration
# Required for evidence-grounded AI explanations (Phase 3)
GEMINI_API_KEY=""
GEMINI_FLASH_LITE_MODEL="gemini-2.0-flash-lite"
GEMINI_FLASH_MODEL="gemini-2.0-flash"

# Security & Authentication
# Required: Use a strong, random 32+ character key in production
JWT_SECRET_KEY="development-insecure-secret-key-change-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]'
