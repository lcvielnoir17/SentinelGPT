# =============================================================================
# SentinelGPT - Environment Configuration Template
# Copy this file to .env and adjust variables as appropriate.
# DO NOT commit real secrets or credentials to version control.
#
# `docker compose up` FAILS FAST if the required variables below are missing.
# =============================================================================

# Application Configuration
APP_NAME="SentinelGPT API"
APP_VERSION="0.1.0"
ENVIRONMENT="local"
DEBUG=false
API_V1_PREFIX="/api/v1"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# Structured Logging
LOG_LEVEL="INFO"
LOG_JSON=false

# -----------------------------------------------------------------------------
# PostgreSQL (required by docker-compose.yml)
# NOTE: keep POSTGRES_PASSWORD free of URL-special characters (: / @ ? #) or
# percent-encode them — it is interpolated into DATABASE_URL / connection URLs.
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_DB=sentinelgpt

# Local (host-side) database URL used by Alembic/pytest outside Docker.
# Keep the password in sync with POSTGRES_PASSWORD above.
DATABASE_URL="postgresql+asyncpg://postgres:change-me-local-postgres@localhost:5432/sentinelgpt"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Redis (required by docker-compose.yml) — password-protected in every profile
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change-me-local-redis
REDIS_URL="redis://:change-me-local-redis@localhost:6379/0"
CELERY_BROKER_URL="redis://:change-me-local-redis@localhost:6379/1"
CELERY_RESULT_BACKEND="redis://:change-me-local-redis@localhost:6379/2"

# Gemini AI Configuration
# Required for evidence-grounded AI explanations (Phase 3) and the
# conversational security analyst. Leave empty for degraded/no-AI mode.
GEMINI_API_KEY=""
GEMINI_FLASH_LITE_MODEL="gemini-2.0-flash-lite"
GEMINI_FLASH_MODEL="gemini-2.0-flash"

# -----------------------------------------------------------------------------
# Firebase Authentication (Ideathon identity bridge)
# Public web config lives in the frontend (VITE_FIREBASE_*); the backend needs
# only the project ID to verify ID tokens against Google's public JWKs.
# Empty disables the POST /api/v1/auth/firebase exchange endpoint.
# Local Firestore/Secret Manager access additionally uses ADC:
#   gcloud auth application-default login   (or GOOGLE_APPLICATION_CREDENTIALS)
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIRESTORE_CONVERSATIONS_ENABLED=true
FIRESTORE_DATABASE_ID="(default)"

# -----------------------------------------------------------------------------
# Google Cloud Secret Manager (production secret source)
# When GEMINI_API_KEY_SECRET is set to a resource name
# (projects/PROJECT/secrets/SECRET/versions/latest) the API resolves the
# Gemini key through Secret Manager instead of GEMINI_API_KEY.
# On Cloud Run you can alternatively inject GEMINI_API_KEY via --set-secrets.
# -----------------------------------------------------------------------------
GEMINI_API_KEY_SECRET=""
SECRET_MANAGER_ENABLED=true

# Conversational analyst safeguards
CONVERSATION_MAX_MESSAGE_CHARS=8000
CONVERSATION_MAX_HISTORY_MESSAGES=40
CONVERSATION_MAX_CONTEXT_CHARS=12000
CONVERSATION_RATE_LIMIT_PER_MINUTE=12

# Security & Authentication
# LOCAL/TEST ONLY placeholder below. ENVIRONMENT=staging|production refuses to
# boot with this value or any secret shorter than 32 characters — generate a
# strong unique secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="development-insecure-secret-key-change-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]'

# Scan execution gate (ADR-0009). Keep false unless a Celery worker with
# Docker-socket access runs alongside (see docs/operations/local-dev-with-scanner.md).
SCANNER_EXECUTION_ENABLED=false
# Sandbox image (ADR-0003). Local development tracks :latest; production
# should pin an immutable digest, e.g.
# sentinelgpt/scanner-sandbox:1.4.2@sha256:<digest>.
SCANNER_SANDBOX_IMAGE="sentinelgpt/scanner-sandbox:latest"

# Public demo edge (docker-compose.production.yml only).
# Set to your DNS domain to enable automatic Let's Encrypt certificates.
SITE_ADDRESS=:80
