# Rendered by the nginx image's envsubst mechanism (docker-entrypoint.d)
# from /etc/nginx/templates/default.conf.template into default.conf.
#
# API_UPSTREAM — the backend origin:
#   docker compose:  http://api:8000
#   Cloud Run:       https://<api-service>-<hash>-<region>.run.app
# Requests stay same-origin through this proxy, so the SPA's HttpOnly
# session cookies remain first-party and no browser CORS round-trip occurs.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Same-origin proxy to the FastAPI backend.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA history fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
