# =============================================================================
# SentinelGPT Frontend - Vite environment template
# Copy to .env.local (never committed) or inject at build time.
# These values are PUBLIC Firebase web configuration: the web API key
# identifies the Firebase project but grants no access; all authorization
# happens server-side when the backend verifies the ID token (ADR-0010).
# =============================================================================

# Firebase web app config (Project settings > General > Your apps > SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
